# Copy to .env (git-ignored). Values are read by compose and by the engine's own processes; nothing here is ever printed.

# ── the graph ────────────────────────────────────────────────────────────────────────────────────────────────────
PGUSER=memory
PGPASSWORD=change-me
PGDATABASE=memory
PGPORT=5433
# the engine's processes on the host reach the compose postgres through this; unset it and the in-process graph is used
GRAPH_DSN=postgresql://memory:change-me@127.0.0.1:5433/memory
# GRAPH_PATH=graph.json                      # the in-process graph's file, when GRAPH_DSN is unset

# ── embeddings: one of the three doors ───────────────────────────────────────────────────────────────────────────
EMBED_KIND=ollama                             # ollama | openai | fake
EMBED_URL=http://127.0.0.1:11434              # openai: the /v1 base of any embeddings-compatible endpoint
# EMBED_URL_CONTAINER=http://ollama:11434     # what the recall-api CONTAINER calls (127.0.0.1 there is the container itself)
EMBED_MODEL=nomic-embed-text                  # openai: e.g. text-embedding-3-small
EMBED_API_KEY=
EMBED_DIM=768                                 # must match the model; the schema's vector column is created with it
# EMBED_PREFIX=1                              # task prefixes (search_document: / search_query:); default on for ollama

# ── the model (the judge, the Gardener, the reviewer); leave empty to run the deterministic halves only ──────────
MODEL_KIND=anthropic                          # anthropic (Messages API) | openai (any /chat/completions door)
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# VERIFIER_MODEL= GARDENER_MODEL= REVIEW_MODEL=   # per-job model overrides (name only)

# ── the recall API and the hook ──────────────────────────────────────────────────────────────────────────────────
RECALL_TOKEN=change-me-too                    # every request but /healthz carries it as a Bearer token
RECALL_PORT=8450
RECALL_URL=http://127.0.0.1:8450              # what the hook calls
HOOK_K=3
HOOK_MIN_SIM=0.60
HOOK_EXCLUDE_TYPES=

# ── the review lane ──────────────────────────────────────────────────────────────────────────────────────────────
REVIEW_HUMAN_NAME=                            # a changed line that names the human is held for them
IDENTITY_SCOPE=identity                       # metadata.project of memories about the pair; never auto-merged
